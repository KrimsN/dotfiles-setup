{
  "$schema": "../schemas/pkg.schema.json",
  "$comment": "Метод 'pkg': имя пакета в каждом пакетном менеджере. У большинства пакетов проекта имя совпадает во всех трёх менеджерах, но поле оставлено per-manager намеренно — реальные кейсы расхождения: fd -> fd-find (одинаков для apt/dnf/yum, просто отличается от канонического имени 'fd'), dig -> dnsutils/bind-utils (apt vs dnf/yum) и mtr -> mtr-tiny/mtr (apt тянет GUI-зависимости под именем 'mtr', CLI-only пакет называется 'mtr-tiny').",

  "tldr":    { "apt": "tldr",    "dnf": "tldr",    "yum": "tldr" },
  "ripgrep": { "apt": "ripgrep", "dnf": "ripgrep", "yum": "ripgrep" },
  "fd":      { "apt": "fd-find", "dnf": "fd-find", "yum": "fd-find" },
  "fzf":     { "apt": "fzf",     "dnf": "fzf",     "yum": "fzf" },
  "bat":     { "apt": "bat",     "dnf": "bat",     "yum": "bat" },
  "jq":      { "apt": "jq",      "dnf": "jq",      "yum": "jq" },
  "httpie":  { "apt": "httpie",  "dnf": "httpie",  "yum": "httpie" },
  "delta":   { "apt": "git-delta", "dnf": "git-delta", "yum": "git-delta" },
  "zoxide":  { "apt": "zoxide",  "dnf": "zoxide",  "yum": "rust-zoxide" },
  "rsync":   { "apt": "rsync",   "dnf": "rsync",   "yum": "rsync" },
  "dig":     { "apt": "dnsutils", "dnf": "bind-utils", "yum": "bind-utils" },
  "lsof":    { "apt": "lsof",    "dnf": "lsof",    "yum": "lsof" },
  "mtr":     { "apt": "mtr-tiny", "dnf": "mtr",    "yum": "mtr" },
  "ncdu":    { "apt": "ncdu",    "dnf": "ncdu",    "yum": "ncdu" },
  "direnv":  { "apt": "direnv",  "dnf": "direnv",  "yum": "" }
}
