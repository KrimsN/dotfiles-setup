# Managed by dotfiles-setup.
# Этот файл копируется в ~/.zshrc модулем modules/zsh.sh. Если уже
# существует и отличается — скрипт делает бэкап перед перезаписью
# (см. zsh::write_zshrc), а не молча затирает.

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  sudo
  command-not-found
  extract
  colored-man-pages
  history-substring-search
  docker
  docker-compose
  zsh-autosuggestions
  fast-syntax-highlighting
  zsh-completions
)

source "$ZSH/oh-my-zsh.sh"

# Powerlevel10k сам запускает мастер настройки при первом интерактивном
# запуске, если ~/.p10k.zsh ещё не существует.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# tmux: если модуль tmux.sh ставил хук авто-подключения к существующей
# сессии — подключаем. Условно, чтобы zsh.sh не зависел от tmux.sh.
[[ ! -f ~/.config/dotfiles-setup/tmux-autoattach.sh ]] || source ~/.config/dotfiles-setup/tmux-autoattach.sh

# Личные алиасы: если модуль aliases.sh их ставил — подключаем.
# Условно, чтобы zsh.sh не зависел от aliases.sh.
[[ ! -f ~/.config/dotfiles-setup/aliases.sh ]] || source ~/.config/dotfiles-setup/aliases.sh
