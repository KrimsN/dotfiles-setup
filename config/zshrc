# Managed by .knrc.
# Этот файл копируется в ~/.zshrc модулем modules/zsh.sh. Если уже
# существует и отличается — скрипт делает бэкап перед перезаписью
# (см. zsh::write_zshrc), а не молча затирает.

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

# Кэш автодополнения — до compinit (запускается внутри oh-my-zsh.sh),
# чтобы применился с первого запуска.
mkdir -p "$HOME/.zsh/cache"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.zsh/cache"

plugins=(
  git
  sudo
  command-not-found
  extract
  colored-man-pages
  history-substring-search
  docker
  docker-compose
  zsh-autosuggestions
  fast-syntax-highlighting
  zsh-completions
)

source "$ZSH/oh-my-zsh.sh"

# Powerlevel10k сам запускает мастер настройки при первом интерактивном
# запуске, если ~/.p10k.zsh ещё не существует.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# История команд: расширенный размер, общий между сессиями, без дублей.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt APPEND_HISTORY           # дописывать, а не перезаписывать
setopt SHARE_HISTORY            # общая история между сессиями
setopt HIST_IGNORE_DUPS         # не писать повторы подряд
setopt HIST_IGNORE_ALL_DUPS     # убирать старые дубли при повторе
setopt HIST_SAVE_NO_DUPS        # не сохранять дубли в файл
setopt HIST_FIND_NO_DUPS        # пропускать дубли при поиске по истории
setopt HIST_IGNORE_SPACE        # не писать в историю команды с ведущим пробелом
setopt HIST_REDUCE_BLANKS       # убирать лишние пробелы перед записью в историю

setopt AUTO_CD                  # `dirname` без `cd` переходит в каталог
setopt INTERACTIVE_COMMENTS     # `#...` в интерактивном вводе — комментарий, а не ошибка
setopt EXTENDED_GLOB            # расширенные шаблоны глобов (^, ~, # и т.п.)

# Стрелки вверх/вниз ищут по префиксу уже введённой команды.
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward

# Home / End / Delete: сначала terminfo (учитывает реальный $TERM — это
# критично в tmux/SSH, где TERM подменяется на screen-256color/tmux-256color
# и обычные xterm-последовательности могут не совпадать), затем сырые
# escape-последовательности как fallback на случай отсутствующей или неполной
# terminfo-записи (частый случай в urxvt/старых линукс-консолях).
[[ -n "${terminfo[khome]:-}" ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n "${terminfo[kend]:-}"  ]] && bindkey "${terminfo[kend]}"  end-of-line
[[ -n "${terminfo[kdch1]:-}" ]] && bindkey "${terminfo[kdch1]}" delete-char

bindkey '\e[1~' beginning-of-line   # Home, fallback (VT220/линукс-консоль)
bindkey '\e[7~' beginning-of-line   # Home, fallback (rxvt/urxvt)
bindkey '\e[H'  beginning-of-line   # Home, fallback (xterm/screen)
bindkey '\e[4~' end-of-line         # End, fallback (VT220/линукс-консоль)
bindkey '\e[8~' end-of-line         # End, fallback (rxvt/urxvt)
bindkey '\e[F'  end-of-line         # End, fallback (xterm/screen)
bindkey '\e[3~' delete-char         # Delete, fallback (большинство терминалов)

# Ctrl+стрелки — переход по словам вперёд/назад. Terminfo обычно не хранит
# capability для Ctrl+стрелок, поэтому сразу перечисляем варианты
# escape-последовательностей, реально встречающиеся в разных терминалах и
# внутри tmux (xterm/screen и rxvt дают разные коды).
bindkey '\e[1;5C' forward-word      # Ctrl+Right, xterm/screen
bindkey '\e[1;5D' backward-word     # Ctrl+Left, xterm/screen
bindkey '\eOc' forward-word         # Ctrl+Right, rxvt
bindkey '\eOd' backward-word        # Ctrl+Left, rxvt
bindkey '\e[c' forward-word         # Ctrl+Right, ещё один встречающийся вариант
bindkey '\e[d' backward-word        # Ctrl+Left, ещё один встречающийся вариант

# Редактор по умолчанию: nvim, если поставлен модулем nvim.sh, иначе vim,
# либо не трогаем переменные вовсе (пусть остаются системные значения/пусто).
if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="vim"
  export VISUAL="vim"
fi

export PAGER="less"
# -R: показывать ANSI-цвета как есть (нужно для delta/bat и т.п.), а не
#     escape-последовательностями;
# -F: если вывод помещается на один экран — сразу выйти, не открывать pager;
# -X: не очищать экран при выходе (сохранить вывод команды в терминале).
export LESS='-R -F -X'

# tmux: если модуль tmux.sh ставил хук авто-подключения к существующей
# сессии — подключаем. Условно, чтобы zsh.sh не зависел от tmux.sh.
[[ ! -f ~/.config/knrc/tmux-autoattach.sh ]] || source ~/.config/knrc/tmux-autoattach.sh

# Личные алиасы: если модуль aliases.sh их ставил — подключаем.
# Условно, чтобы zsh.sh не зависел от aliases.sh.
[[ ! -f ~/.config/knrc/aliases.sh ]] || source ~/.config/knrc/aliases.sh

# PATH для uv/ruff (~/.local/bin): если модуль python-tools.sh его
# ставил — подключаем. Условно, чтобы zsh.sh не зависел от
# python-tools.sh.
[[ ! -f ~/.config/knrc/path.sh ]] || source ~/.config/knrc/path.sh

# fzf/zoxide: интеграция с шеллом, если бинарники уже поставлены
# модулем cli-tools.sh. Guard на command -v, чтобы zsh.sh не зависел
# от порядка установки модулей.
#
# fzf: `fzf --zsh` появился в 0.48 (2024) и печатает готовый
# init-скрипт. На Debian/Ubuntu из apt может стоять более старая
# версия (например 0.44 на Ubuntu 24.04) без этого флага — тогда
# используем биндинги, которые пакет всё равно кладёт на диск.
if command -v fzf >/dev/null 2>&1; then
  if _fzf_zsh_init="$(fzf --zsh 2>/dev/null)"; then
    eval "$_fzf_zsh_init"
  else
    [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
    [[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
  fi
  unset _fzf_zsh_init
fi

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# direnv: автоактивация .venv (через uv) и прочих project-scoped
# переменных при cd в каталог с .envrc. Guard на command -v, чтобы
# zsh.sh не зависел от порядка установки модулей (ставится cli-tools.sh).
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# Локальные правки пользователя: этот файл перезаписывается install.sh при
# каждом запуске, поэтому здесь нет места для собственных настроек — они
# подключаются отдельным файлом, который install.sh не трогает.
[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local
